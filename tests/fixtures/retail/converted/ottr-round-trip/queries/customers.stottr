@prefix rt: <http://example.com/retail/template#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <http://example.com/ns#> .
@prefix cur: <http://example.com/currency/> .
@prefix cust: <http://example.com/customer/> .
@prefix prod: <http://example.com/product/> .
@prefix ord: <http://example.com/order/> .
@prefix cat: <http://example.com/category/> .
@prefix country: <http://example.com/country/> .
@prefix status: <http://example.com/status/> .
@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix tq: <http://example.org/ottr-tarql#> .
@prefix tpl: <http://example.com/retail/tpl/> .
@prefix q: <http://example.com/retail/q/> .

q:customers [
    ? ottr:IRI ?id_iri,
    ? ?kind_iri,
    ? xsd:string ?name,
    ? xsd:string ?legal_name,
    ? xsd:string ?email,
    ? xsd:string ?phone,
    ? xsd:date ?born_typed,
    ? xsd:gYear ?founded_typed,
    ? ?homepage_iri,
    ? ottr:IRI ?parent_iri,
    ? xsd:string ?notes,
    !? ottr:IRI ?_g2,
    !? ottr:IRI ?_g9,
    !? ottr:IRI ?_g3,
    !? ottr:IRI ?_g4,
    ? xsd:string ?locality,
    !? ottr:IRI ?_g5,
    ? xsd:string ?street,
    !? ottr:IRI ?_g6,
    ? xsd:string ?postcode,
    !? ottr:IRI ?_g7,
    ? ?country_iri,
    !? ottr:IRI ?_g10,
    !? ottr:IRI ?_g11,
    !? ottr:IRI ?_g12,
    ? xsd:dateTime ?customer_since_typed,
    !? ottr:IRI ?_g13,
    ? xsd:boolean ?vip_typed,
    !? ottr:IRI ?_g14,
    ? xsd:decimal ?credit_limit_typed
]
  @@ tq:Source("customers.rq"),
  @@ tq:Prefix("rt", "http://example.com/retail/template#"),
  @@ tq:Prefix("rdf", "http://www.w3.org/1999/02/22-rdf-syntax-ns#"),
  @@ tq:Prefix("owl", "http://www.w3.org/2002/07/owl#"),
  @@ tq:Prefix("rdfs", "http://www.w3.org/2000/01/rdf-schema#"),
  @@ tq:Prefix("xsd", "http://www.w3.org/2001/XMLSchema#"),
  @@ tq:Prefix("schema", "https://schema.org/"),
  @@ tq:Prefix("ex", "http://example.com/ns#"),
  @@ tq:Prefix("cur", "http://example.com/currency/"),
  @@ tq:Prefix("cust", "http://example.com/customer/"),
  @@ tq:Prefix("prod", "http://example.com/product/"),
  @@ tq:Prefix("ord", "http://example.com/order/"),
  @@ tq:Prefix("cat", "http://example.com/category/"),
  @@ tq:Prefix("country", "http://example.com/country/"),
  @@ tq:Prefix("status", "http://example.com/status/"),
  @@ tq:Bind("id_iri", "IF(CONTAINS(STR(?id), \"://\"), IRI(?id), tarql:expandPrefixedName(?id))"),
  @@ tq:Bind("kind_iri", "IF(CONTAINS(STR(?kind), \"://\"), IRI(?kind), tarql:expandPrefixedName(?kind))"),
  @@ tq:Bind("born_typed", "STRDT(?born, xsd:date)"),
  @@ tq:Bind("founded_typed", "STRDT(?founded, xsd:gYear)"),
  @@ tq:Bind("country_iri", "IF(CONTAINS(STR(?country), \"://\"), IRI(?country), tarql:expandPrefixedName(?country))"),
  @@ tq:Bind("homepage_iri", "IF(CONTAINS(STR(?homepage), \"://\"), IRI(?homepage), tarql:expandPrefixedName(?homepage))"),
  @@ tq:Bind("parent_iri", "IF(CONTAINS(STR(?parent), \"://\"), IRI(?parent), tarql:expandPrefixedName(?parent))"),
  @@ tq:Bind("vip_typed", "STRDT(?vip, xsd:boolean)"),
  @@ tq:Bind("credit_limit_typed", "STRDT(?credit_limit, xsd:decimal)"),
  @@ tq:Bind("customer_since_typed", "STRDT(?customer_since, xsd:dateTime)"),
  @@ tq:Bind("_g2", "IF(sameTerm(?locality, ?locality), schema:address, ?_unbound)"),
  @@ tq:Bind("_g3", "IF(sameTerm(?id_iri, ?id_iri) && sameTerm(?locality, ?locality), rdf:type, ?_unbound)"),
  @@ tq:Bind("_g4", "IF(sameTerm(?id_iri, ?id_iri), schema:addressLocality, ?_unbound)"),
  @@ tq:Bind("_g5", "IF(sameTerm(?id_iri, ?id_iri) && sameTerm(?locality, ?locality), schema:streetAddress, ?_unbound)"),
  @@ tq:Bind("_g6", "IF(sameTerm(?id_iri, ?id_iri) && sameTerm(?locality, ?locality), schema:postalCode, ?_unbound)"),
  @@ tq:Bind("_g7", "IF(sameTerm(?id_iri, ?id_iri) && sameTerm(?locality, ?locality), schema:addressCountry, ?_unbound)"),
  @@ tq:Bind("_g9", "IF(sameTerm(?customer_since_typed, ?customer_since_typed), ex:account, ?_unbound)"),
  @@ tq:Bind("_g10", "IF(sameTerm(?customer_since_typed, ?customer_since_typed) && sameTerm(?id_iri, ?id_iri), rdf:type, ?_unbound)"),
  @@ tq:Bind("_g11", "IF(sameTerm(?customer_since_typed, ?customer_since_typed) && sameTerm(?id_iri, ?id_iri), rdfs:label, ?_unbound)"),
  @@ tq:Bind("_g12", "IF(sameTerm(?id_iri, ?id_iri), ex:customerSince, ?_unbound)"),
  @@ tq:Bind("_g13", "IF(sameTerm(?customer_since_typed, ?customer_since_typed) && sameTerm(?id_iri, ?id_iri), ex:vip, ?_unbound)"),
  @@ tq:Bind("_g14", "IF(sameTerm(?customer_since_typed, ?customer_since_typed) && sameTerm(?id_iri, ?id_iri), ex:creditLimit, ?_unbound)")
:: {
    tpl:Customer(?id_iri, ?kind_iri, ?notes, ?born_typed, ?email, ?founded_typed, ?legal_name, ?name, ?parent_iri, ?phone, ?homepage_iri, ?_g2, _:b1, ?_g9, _:b8),
    tpl:Parent(?parent_iri, ?id_iri),
    tpl:Node_4(_:b1, ?_g3, ?_g4, ?locality, ?_g5, ?street, ?_g6, ?postcode, ?_g7, ?country_iri),
    tpl:Node_5(_:b8, ?_g10, ?_g11, ?_g13, ?vip_typed, ?_g12, ?customer_since_typed, ?_g14, ?credit_limit_typed)
} .
