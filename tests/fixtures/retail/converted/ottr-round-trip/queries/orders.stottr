@prefix rt: <http://example.com/retail/template#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ex: <http://example.com/ns#> .
@prefix cur: <http://example.com/currency/> .
@prefix cust: <http://example.com/customer/> .
@prefix prod: <http://example.com/product/> .
@prefix ord: <http://example.com/order/> .
@prefix cat: <http://example.com/category/> .
@prefix country: <http://example.com/country/> .
@prefix status: <http://example.com/status/> .
@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix tq: <http://example.org/ottr-tarql#> .
@prefix tpl: <http://example.com/retail/tpl/> .
@prefix q: <http://example.com/retail/q/> .

q:orders [
    ? ottr:IRI ?order_iri,
    ? xsd:dateTime ?ordered_at_typed,
    ? ?customer_iri,
    ? xsd:string ?channel,
    ? ?status_iri,
    ? xsd:string ?gift_message,
    !? ottr:IRI ?_g2,
    !? ottr:IRI ?_g3,
    !? ottr:IRI ?_g4,
    ? xsd:integer ?line_typed,
    !? ottr:IRI ?_g5,
    ? ?product_iri,
    !? ottr:IRI ?_g6,
    ? xsd:integer ?qty_typed,
    !? ottr:IRI ?_g7,
    ? xsd:decimal ?discount_pct_typed,
    !? ottr:IRI ?_g8,
    ? xsd:integer ?ROWNUM,
    !? ottr:IRI ?_g11,
    !? ottr:IRI ?_g16,
    !? ottr:IRI ?_g12,
    !? ottr:IRI ?_g13,
    ? xsd:decimal ?unit_price_typed,
    !? ottr:IRI ?_g14,
    ? ?currency_iri_d10,
    !? ottr:IRI ?_g17,
    !? ottr:IRI ?_g18,
    ? xsd:date ?shipped_on_typed,
    !? ottr:IRI ?_g19,
    ? xsd:string ?carrier,
    !? ottr:IRI ?_g20,
    ? xsd:string ?tracking
]
  @@ tq:Source("orders.rq"),
  @@ tq:Prefix("rt", "http://example.com/retail/template#"),
  @@ tq:Prefix("rdf", "http://www.w3.org/1999/02/22-rdf-syntax-ns#"),
  @@ tq:Prefix("owl", "http://www.w3.org/2002/07/owl#"),
  @@ tq:Prefix("rdfs", "http://www.w3.org/2000/01/rdf-schema#"),
  @@ tq:Prefix("xsd", "http://www.w3.org/2001/XMLSchema#"),
  @@ tq:Prefix("schema", "https://schema.org/"),
  @@ tq:Prefix("ex", "http://example.com/ns#"),
  @@ tq:Prefix("cur", "http://example.com/currency/"),
  @@ tq:Prefix("cust", "http://example.com/customer/"),
  @@ tq:Prefix("prod", "http://example.com/product/"),
  @@ tq:Prefix("ord", "http://example.com/order/"),
  @@ tq:Prefix("cat", "http://example.com/category/"),
  @@ tq:Prefix("country", "http://example.com/country/"),
  @@ tq:Prefix("status", "http://example.com/status/"),
  @@ tq:Bind("order_iri", "IF(CONTAINS(STR(?order), \"://\"), IRI(?order), tarql:expandPrefixedName(?order))"),
  @@ tq:Bind("ordered_at_typed", "STRDT(?ordered_at, xsd:dateTime)"),
  @@ tq:Bind("customer_iri", "IF(CONTAINS(STR(?customer), \"://\"), IRI(?customer), tarql:expandPrefixedName(?customer))"),
  @@ tq:Bind("status_iri", "IF(CONTAINS(STR(?status), \"://\"), IRI(?status), tarql:expandPrefixedName(?status))"),
  @@ tq:Bind("line_typed", "STRDT(?line, xsd:integer)"),
  @@ tq:Bind("product_iri", "IF(CONTAINS(STR(?product), \"://\"), IRI(?product), tarql:expandPrefixedName(?product))"),
  @@ tq:Bind("qty_typed", "STRDT(?qty, xsd:integer)"),
  @@ tq:Bind("unit_price_typed", "STRDT(?unit_price, xsd:decimal)"),
  @@ tq:Bind("currency_iri", "IF(CONTAINS(STR(?currency), \"://\"), IRI(?currency), tarql:expandPrefixedName(?currency))"),
  @@ tq:Bind("discount_pct_typed", "STRDT(?discount_pct, xsd:decimal)"),
  @@ tq:Bind("shipped_on_typed", "STRDT(?shipped_on, xsd:date)"),
  @@ tq:Bind("_g2", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?product_iri, ?product_iri), schema:orderedItem, ?_unbound)"),
  @@ tq:Bind("_g3", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), rdf:type, ?_unbound)"),
  @@ tq:Bind("_g4", "IF(sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), ex:lineNumber, ?_unbound)"),
  @@ tq:Bind("_g5", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri), schema:orderedItem, ?_unbound)"),
  @@ tq:Bind("_g6", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), schema:orderQuantity, ?_unbound)"),
  @@ tq:Bind("_g7", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), ex:discountPercent, ?_unbound)"),
  @@ tq:Bind("_g8", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), ex:sourceRow, ?_unbound)"),
  @@ tq:Bind("currency_iri_d10", "COALESCE(?currency_iri, cur:EUR)"),
  @@ tq:Bind("_g11", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?unit_price_typed, ?unit_price_typed), ex:unitPrice, ?_unbound)"),
  @@ tq:Bind("_g12", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?unit_price_typed, ?unit_price_typed), rdf:type, ?_unbound)"),
  @@ tq:Bind("_g13", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), schema:price, ?_unbound)"),
  @@ tq:Bind("_g14", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?unit_price_typed, ?unit_price_typed), schema:priceCurrency, ?_unbound)"),
  @@ tq:Bind("_g16", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?shipped_on_typed, ?shipped_on_typed), ex:shipment, ?_unbound)"),
  @@ tq:Bind("_g17", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?shipped_on_typed, ?shipped_on_typed), rdf:type, ?_unbound)"),
  @@ tq:Bind("_g18", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri), ex:shippedOn, ?_unbound)"),
  @@ tq:Bind("_g19", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?shipped_on_typed, ?shipped_on_typed), ex:carrier, ?_unbound)"),
  @@ tq:Bind("_g20", "IF(sameTerm(?line_typed, ?line_typed) && sameTerm(?order_iri, ?order_iri) && sameTerm(?product_iri, ?product_iri) && sameTerm(?shipped_on_typed, ?shipped_on_typed), ex:trackingNumber, ?_unbound)")
:: {
    tpl:Order(?order_iri, ?channel, ?gift_message, ?customer_iri, ?ordered_at_typed, ?status_iri, ?_g2, _:b1),
    tpl:Node_6(_:b1, ?_g3, ?_g11, _:b9, ?_g16, _:b15, ?_g7, ?discount_pct_typed, ?_g4, ?line_typed, ?_g6, ?qty_typed, ?_g8, ?ROWNUM, ?_g5, ?product_iri),
    tpl:Node(_:b9, ?_g12, ?_g13, ?unit_price_typed, ?_g14, ?currency_iri_d10),
    tpl:Node_3(_:b15, ?_g17, ?_g18, ?shipped_on_typed, ?_g19, ?carrier, ?_g20, ?tracking)
} .
